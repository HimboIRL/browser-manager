{
  "manifest_version": 3,
  "name": "Browser Manager",
  "short_name": "Browser Manager",
  "version": "1.0.0",
  "description": "Enterprise browser utility. One-click cache clearing plus managed performance and privacy controls. Managed by IT Help Desk.",
  "author": "Browser Manager",
  "minimum_chrome_version": "110",
  "permissions": [
    "browsingData",
    "storage",
    "tabs",
    "privacy",
    "contentSettings",
    "alarms",
    "system.memory",
    "system.cpu",
    "processes"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
